# =============================================================================
# NeuroChat backend — environment configuration
# Copy this file to ".env" and fill in real values. Never commit ".env".
# =============================================================================

# --- Firebase Admin SDK (server-side ONLY, never expose these) ---
# Firebase Console > Project Settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Gemini (primary AI provider) ---
# Key: https://aistudio.google.com/apikey
# Current model names: https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OpenRouter (fallback #1, optional — leave blank to skip) ---
# Key: https://openrouter.ai/keys
# Models: https://openrouter.ai/models  (namespaced, e.g. google/gemini-2.5-flash)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Groq (fallback #2, optional — leave blank to skip) ---
# Key: https://console.groq.com/keys
# Current models: https://console.groq.com/docs/models
# Deprecations: https://console.groq.com/docs/deprecations
GROQ_API_KEY=
GROQ_MODEL=

# Order providers are tried in, comma-separated. Any provider not
# configured (missing key/model) is skipped automatically.
AI_PROVIDER_ORDER=gemini,openrouter,groq

# --- Conversation memory / context management ---
# Max recent messages considered per request.
MAX_HISTORY_MESSAGES=20
# Approximate token ceiling (≈4 chars/token) for the history sent to the AI.
MAX_CONTEXT_TOKENS=6000
# Optional system prompt prepended to every conversation. Leave blank to disable.
SYSTEM_PROMPT="You are NeuroChat, a helpful, concise AI assistant. Use markdown formatting (including code blocks with language tags) where it helps."

# --- Security / rate limiting ---
# Reject request bodies larger than this many bytes.
MAX_REQUEST_BODY_BYTES=32000
# Per-user chat rate limit: N requests per window (seconds).
CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# --- Web Search Grounding (Tavily — works with all 3 providers) ---
# Get a free key at: https://tavily.com  (free tier: 1000 searches/month)
# This is used instead of relying on Gemini's own (unreliable) built-in
# search tool — search results are fetched once here and handed to
# whichever provider answers, so grounding works the same for Gemini,
# OpenRouter, and Groq.
ENABLE_SEARCH_GROUNDING=true
TAVILY_API_KEY=
# Comma-separated, case-insensitive substring match against the user's message.
GROUNDING_KEYWORDS="today,current,currently,latest,recent,recently,this week,this month,this year,right now,breaking news,news,live score,live,update,updates,stock price,share price,exchange rate,weather,who is the,cm of,chief minister,prime minister,president of,election result,as of today,up to date,up-to-date,new release,just announced"

# --- App config ---
DATABASE_TYPE=firestore
FRONTEND_URL=http://localhost:3000
